cabal-version: 3.0
name:          hcc
version:       0.1.0.0
build-type:    Simple

common warnings
  ghc-options: -Wall
               -Wcompat
               -Widentities
               -Wincomplete-record-updates
               -Wincomplete-uni-patterns
               -Wmissing-export-lists
               -Wmissing-home-modules
               -Wpartial-fields
               -Wredundant-constraints

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  HCC.Lexer
  build-depends:    base >=4 && <5
  default-language: Haskell2010

executable hcc
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base >=4 && <5
                  , hcc
  default-language: Haskell2010
